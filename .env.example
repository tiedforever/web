# Prisma/PostgreSQL
# App runtime connection. Use a separate database for each hosted environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# Direct connection required by Prisma CLI migrations. It may match DATABASE_URL locally.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# Optional shadow database used by some local Prisma migration workflows.
SHADOW_DATABASE_URL=""

# Clerk authentication
# Local-development examples only. Use separate Clerk instances/keys for Preview and Production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_with_your_publishable_key"
CLERK_SECRET_KEY="sk_test_replace_with_your_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Server-only URL used in workspace member invitation links. This localhost value is for Local only.
# Set https://qa.tied-forever.com in Preview and https://tied-forever.com in Production.
APP_URL="http://localhost:3000"

# Workspace invitation email transport
# Local default only. Hosted deployments must use Resend with environment-specific credentials.
EMAIL_PROVIDER="development"
RESEND_API_KEY=""
EMAIL_FROM="Tied Forever <hello@example.local>"
